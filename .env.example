# Copy to .env and replace every CHANGE_ME value
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.pt
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD_AT_LEAST_16_CHARS
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
BEDROCK_WEB_SEARCH_ENABLED=true
BEDROCK_WEB_SEARCH_ID=web-search.v1
FRONTEND_ORIGIN=http://localhost
MICROSOFT_TENANT_ID=your-entra-tenant-id
MICROSOFT_CLIENT_ID=your-entra-app-client-id
MICROSOFT_CLIENT_SECRET=your-entra-client-secret
MICROSOFT_REDIRECT_URI=https://estateai.example.pt/api/v1/integrations/microsoft/callback
GOOGLE_MAPS_API_KEY=
LEAD_SCORE_THRESHOLD=60
DEFAULT_COUNTRY=Portugal
TIMEZONE=Europe/Lisbon
DATABASE_URL=postgresql+psycopg://estateai:CHANGE_ME@db:5432/estateai
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
